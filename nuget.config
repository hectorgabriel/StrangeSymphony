<?xml version="1.0" encoding="utf-8"?>
<!-- Every dependency is on nuget.org. Clearing machine-level sources keeps restores reproducible and avoids
     NU1507 (central package management + several sources) turning into an error under TreatWarningsAsErrors. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
