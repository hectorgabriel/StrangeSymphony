root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,xml,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# ---- Conventions this codebase follows ------------------------------------------------------
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents_when_block = false
csharp_prefer_braces = when_multiline:suggestion

csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning

# Private and internal fields: _camelCase. Constants and static readonly: PascalCase.
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, internal, private_protected
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.constants_are_pascal.symbols = constant_fields
dotnet_naming_rule.constants_are_pascal.style = pascal
dotnet_naming_rule.constants_are_pascal.severity = warning
dotnet_naming_rule.static_readonly_are_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_are_pascal.style = pascal
dotnet_naming_rule.static_readonly_are_pascal.severity = warning
dotnet_naming_rule.private_fields_are_underscore_camel.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel.style = underscore_camel
dotnet_naming_rule.private_fields_are_underscore_camel.severity = warning

# The build only enforces IDE rules whose severity is set by id, so name each enforced one.
dotnet_diagnostic.IDE0040.severity = warning # accessibility modifiers
dotnet_diagnostic.IDE0044.severity = warning # readonly fields
dotnet_diagnostic.IDE0065.severity = warning # usings outside the namespace
dotnet_diagnostic.IDE0161.severity = warning # file-scoped namespaces
dotnet_diagnostic.IDE1006.severity = warning # naming rules above

# ---- Analyzer rules turned off, with reasons -------------------------------------------------
# Log calls use message templates; LoggerMessage source generation buys nothing at these call
# rates and would replace every log line.
dotnet_diagnostic.CA1848.severity = none

[tests/**.cs]
# xUnit test names read as sentences.
dotnet_diagnostic.CA1707.severity = none
# Fakes expose counters as public fields so tests can use Interlocked on them.
dotnet_diagnostic.CA1051.severity = none
# Test-class and fake ergonomics, not production API design.
dotnet_diagnostic.CA1725.severity = none
dotnet_diagnostic.CA1816.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1861.severity = none
